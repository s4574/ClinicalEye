diff --git a/Final_Test/config.py b/Final_Test/config.py
index ba607e4..d42b41d 100644
--- a/Final_Test/config.py
+++ b/Final_Test/config.py
@@ -66,6 +66,65 @@ def _load_api_key() -> str:
 OPENAI_API_KEY = _load_api_key()
 
 
+# ============================================================================
+# ADAPTATION (ours, documented). Two additions, both no-ops unless the env var
+# is set, so the released behaviour is unchanged by default:
+#
+#  1. FINAL_TEST_EXTRA_BODY: JSON merged into every chat.completions.create()
+#     as extra_body. We need it only to run GLM-5.3-Flash with thinking
+#     disabled ({"thinking": {"type": "disabled"}}), matching how our own
+#     agent calls GLM (HANDOFF 5.3).
+#  2. Token accounting: the released code drops response.usage, and HANDOFF 6
+#     asks for per-model token totals. record_usage() only accumulates and
+#     never influences the prompts or the control flow.
+# ============================================================================
+import json as _json  # noqa: E402
+import threading as _threading  # noqa: E402
+
+EXTRA_BODY = _json.loads(os.environ.get("FINAL_TEST_EXTRA_BODY") or "{}")
+
+API_USAGE = {
+    "calls": 0,
+    "calls_with_usage": 0,
+    "prompt_tokens": 0,
+    "completion_tokens": 0,
+    "total_tokens": 0,
+}
+_USAGE_LOCK = _threading.Lock()
+
+
+def extra_body_kwargs() -> dict:
+    return {"extra_body": EXTRA_BODY} if EXTRA_BODY else {}
+
+
+def record_usage(response: Any) -> None:
+    usage = getattr(response, "usage", None)
+    with _USAGE_LOCK:
+        API_USAGE["calls"] += 1
+        if usage is None:
+            return
+        API_USAGE["calls_with_usage"] += 1
+        for key, attr in (
+            ("prompt_tokens", "prompt_tokens"),
+            ("completion_tokens", "completion_tokens"),
+            ("total_tokens", "total_tokens"),
+        ):
+            value = getattr(usage, attr, None)
+            if isinstance(value, int):
+                API_USAGE[key] += value
+
+
+def dump_usage(path: str | None = None) -> dict:
+    target = path or os.environ.get("FINAL_TEST_USAGE_LOG")
+    with _USAGE_LOCK:
+        snapshot = dict(API_USAGE)
+    if target:
+        os.makedirs(os.path.dirname(target) or ".", exist_ok=True)
+        with open(target, "w", encoding="utf-8") as handle:
+            _json.dump(snapshot, handle, indent=2)
+    return snapshot
+
+
 def _apply_local_overrides() -> None:
     try:
         from config_run import LOCAL_OVERRIDES
